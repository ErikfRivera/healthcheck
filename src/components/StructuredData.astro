---
/**
 * JSON-LD for the homepage: Organization, WebSite and FAQPage, all built from
 * src/data/site.ts so the markup can never drift from the visible content.
 *
 * TODO(launch): no Offer/Product/price markup until the PLACEHOLDER prices
 * and stats in site.ts are replaced with real network numbers (see the
 * before-launch checklist in the README). Emitting structured pricing on
 * placeholder data risks indexing misinformation.
 */
import { site, faqs, footer, scans, scansIndex } from '../data/site';
import { siteSummary } from '../utils/markdown';
import { stripCites } from '../utils/cite';

const origin = Astro.site?.href ?? '/';
const scanUrl = (slug: string) => new URL(`/scans/${slug}/`, origin).href;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('#organization', origin).href,
      name: site.name,
      url: origin,
      logo: new URL('/favicon.svg', origin).href,
      description: siteSummary,
      disambiguatingDescription: footer.disclaimer,
    },
    {
      '@type': 'WebSite',
      '@id': new URL('#website', origin).href,
      name: site.name,
      url: origin,
      publisher: { '@id': new URL('#organization', origin).href },
    },
    {
      '@type': 'WebPage',
      '@id': new URL('#webpage', origin).href,
      url: origin,
      name: site.name,
      description: siteSummary,
      inLanguage: 'en-US',
      isPartOf: { '@id': new URL('#website', origin).href },
      dateModified: scans.map((s) => s.updated).sort().at(-1),
    },
    {
      /* The twelve scans, each pointing at the test entity its own page defines. */
      '@type': 'ItemList',
      '@id': new URL('#scans', origin).href,
      name: scansIndex.title,
      url: new URL(scansIndex.path, origin).href,
      numberOfItems: scans.length,
      itemListElement: scans.map((scan, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: scanUrl(scan.slug),
        item: {
          '@type': scan.schema.type,
          '@id': `${scanUrl(scan.slug)}#test`,
          name: scan.title,
          alternateName: scan.aka,
          description: stripCites(scan.copy),
          url: scanUrl(scan.slug),
        },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
