---
/**
 * Index of the restored legacy pages, grouped by section of the old site.
 * Linked from the footer only, never the main nav.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { archive, site } from '../data/site';
import { getLegacyEntries, groupBySection, legacyHref } from '../utils/legacy';

const groups = groupBySection(await getLegacyEntries());
---

<Base title={`${archive.index.title} — ${site.name}`} description={archive.index.body}>
  <Nav />

  <main id="main">
    <div class="page">
      <section class="archive">
        <span class="kicker">{archive.kicker}</span>
        <h1 class="archive-headline">{archive.index.headline}</h1>
        <p class="archive-body">{archive.index.body}</p>

        {
          groups.map((g) => (
            <section class="archive-group">
              <h2 class="archive-group-title">{g.heading}</h2>
              <ul class="archive-list">
                {g.entries.map((e) => (
                  <li>
                    <a href={legacyHref(e.data.path)}>{e.data.heading}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </section>

      <hr class="rule" />

      <SiteFooter />
    </div>
  </main>
</Base>

<style>
  .archive {
    padding: 84px 0 70px;
  }

  .archive-headline {
    font-size: 32px;
    line-height: 42px;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .archive-body {
    font-size: 15.5px;
    line-height: 26px;
    max-width: 58ch;
    margin: var(--space-4) 0 0;
    color: var(--ink-78);
  }

  .archive-group {
    margin-top: 56px;
  }

  .archive-group-title {
    font-size: 19px;
    line-height: 26px;
    letter-spacing: 0;
    margin: 0;
  }

  .archive-list {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-2) var(--space-6);
  }

  .archive-list a {
    font-size: 15.5px;
    line-height: 26px;
  }
</style>
