---
import { archive, footer } from '../data/site';
---

<footer class="site-footer">
  {footer.disclaimer} {footer.copyright}{' · '}<a href={archive.index.path}>{archive.footerLink}</a>
</footer>

<style>
  .site-footer {
    padding: 56px 0;
    font-size: 13px;
    line-height: 24px;
    color: var(--ink-70);
    max-width: 72ch;
  }

  .site-footer a {
    color: inherit;
  }
</style>
