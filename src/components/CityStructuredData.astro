---
/**
 * JSON-LD for one "MRI in <city>" page, built from the city's data object so
 * the markup never says anything the visible page does not.
 *
 * Graph: Organization and WebSite (shared @ids with the homepage), the
 * MedicalWebPage about MRI in this city, the City itself, an ItemList of the
 * imaging centers named on the page, a BreadcrumbList and a FAQPage.
 *
 * The listed centers are third parties. They are marked up only as names in
 * a list (with the address as printed and the page they were taken from),
 * never as offers, ratings or anything HealthCheck does not publish itself.
 */
import { site, footer, mriCityPage, mriFloridaHub } from '../data/site';
import { cityPath, type CityMri } from '../data/locations';
import type { Source } from '../data/scans/types';
import { siteSummary } from '../utils/markdown';
import { stripCites } from '../utils/cite';

interface Props {
  city: CityMri;
  sources: Source[];
}

const { city, sources } = Astro.props;
const origin = Astro.site?.href ?? '/';
const pageUrl = new URL(cityPath(city), origin).href;
const orgId = new URL('#organization', origin).href;
const siteId = new URL('#website', origin).href;
const placeId = `${pageUrl}#place`;
const srcUrl = new Map(sources.map((s) => [s.id, s.url]));

const businessType = {
  'Hospital outpatient': 'Hospital',
  'Independent imaging center': 'MedicalClinic',
  'Physician-group imaging center': 'MedicalClinic',
  'Full-body screening clinic': 'MedicalClinic',
} as const;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.name,
      url: origin,
      logo: new URL('/favicon.svg', origin).href,
      description: siteSummary,
      disambiguatingDescription: footer.disclaimer,
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      name: site.name,
      url: origin,
      publisher: { '@id': orgId },
    },
    {
      '@type': 'City',
      '@id': placeId,
      name: city.city,
      containedInPlace: [
        { '@type': 'AdministrativeArea', name: city.county },
        { '@type': 'State', name: 'Florida' },
      ],
    },
    {
      '@type': 'MedicalWebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: mriCityPage.title(city.city),
      headline: mriCityPage.title(city.city),
      description: city.metaDescription,
      abstract: stripCites(city.answer),
      inLanguage: 'en-US',
      isPartOf: { '@id': siteId },
      publisher: { '@id': orgId },
      about: {
        '@type': 'ImagingTest',
        name: 'Magnetic resonance imaging (MRI)',
        imagingTechnique: 'MRI',
        sameAs: ['https://www.wikidata.org/wiki/Q161238'],
      },
      contentLocation: { '@id': placeId },
      spatialCoverage: { '@id': placeId },
      dateModified: city.updated,
      lastReviewed: city.updated,
      audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
      citation: sources.map((s) => ({
        '@type': 'CreativeWork',
        name: s.title,
        publisher: { '@type': 'Organization', name: s.publisher },
        url: s.url,
        datePublished: s.date,
      })),
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      mainEntity: { '@id': `${pageUrl}#providers` },
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#providers`,
      name: mriCityPage.headings.where(city.city),
      numberOfItems: city.providers.length,
      itemListElement: city.providers.map((pr, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': businessType[pr.type],
          name: pr.name,
          address: pr.location,
          url: srcUrl.get(pr.sourceId),
          medicalSpecialty: 'Radiography',
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: mriCityPage.breadcrumb.home, item: origin },
        {
          '@type': 'ListItem',
          position: 2,
          name: mriCityPage.breadcrumb.hub,
          item: new URL(mriFloridaHub.path, origin).href,
        },
        { '@type': 'ListItem', position: 3, name: city.city, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: city.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: stripCites(faq.a) },
      })),
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
