---
import { why } from '../data/site';
---

<section class="why" id="why">
  <div>
    <span class="kicker">{why.kicker}</span>
    <h2 class="why-headline">{why.headline}</h2>
    <p class="why-body">{why.body}</p>
  </div>

  <figure class="why-figure">
    {
      why.photo ? (
        <img class="why-photo" src={why.photo.src} alt={why.photo.alt} width="951" height="665" />
      ) : (
        /* Empty state: drop a real photo in and set `why.photo` in
           src/data/site.ts to replace this. */
        <div class="photo-slot" role="img" aria-label={why.photoPlaceholder}>
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
          <span class="photo-slot-cap">{why.photoPlaceholder}</span>
        </div>
      )
    }
  </figure>
</section>

<style>
  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px clamp(24px, 5vw, 96px);
    align-items: center;
    padding: 56px 0 84px;
  }

  .why-headline {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 32px;
    line-height: 42px;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .why-body {
    font-size: 15.5px;
    line-height: 28px;
    color: var(--ink-78);
    margin: 24px 0 0;
    max-width: 48ch;
  }

  .why-figure {
    margin: 0;
  }

  /* Photography in this system is always desaturated, so a photo never
     competes with the crimson. */
  .why-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 951 / 665;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
  }

  .photo-slot {
    width: 100%;
    aspect-ratio: 951 / 665;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    text-align: center;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    border: 1.5px dashed color-mix(in srgb, var(--color-text) 35%, transparent);
    color: var(--ink-64);
  }

  .photo-slot svg {
    opacity: 0.55;
  }

  .photo-slot-cap {
    max-width: 90%;
    font-size: 13px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
</style>
