---
import { faqs } from '../data/site';
---

<section class="faq" id="faq">
  <span class="kicker kicker--spaced">Common questions</span>
  <div class="faq-grid">
    {
      faqs.map((faq) => (
        <div>
          <h3 class="faq-q">{faq.q}</h3>
          <p class="faq-a">{faq.a}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .faq {
    padding: 84px 0 98px;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 42px clamp(24px, 4vw, 72px);
  }

  .faq-q {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 19px;
    line-height: 26px;
    letter-spacing: normal;
    margin: 0;
  }

  .faq-a {
    font-size: 15px;
    line-height: 26px;
    margin: 12px 0 0;
    color: var(--ink-78);
  }
</style>
