---
/**
 * The /fl/mri/ hub: the statewide answer (what an MRI costs in Florida, the
 * referral question, the price rights every Florida patient has), then a
 * table of every city guide. Statewide content lives in
 * src/data/locations/florida.ts; the city rows come from the city objects.
 */
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { site, footer, mriCityPage, mriFloridaHub as hub } from '../../../data/site';
import { florida, cities, cityPath, floridaSources, floridaUpdated } from '../../../data/locations';
import { citeHtml, sourceIndex, stripCites } from '../../../utils/cite';
import { siteSummary } from '../../../utils/markdown';
import '../../../styles/doc.css';

const sources = floridaSources();
const n = sourceIndex({ sources, slug: 'fl-mri' });
const cite = (text: string) => citeHtml(text, n);

const origin = Astro.site?.href ?? '/';
const pageUrl = new URL(hub.path, origin).href;
const updated = new Date(floridaUpdated).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('#organization', origin).href,
      name: site.name,
      url: origin,
      logo: new URL('/favicon.svg', origin).href,
      description: siteSummary,
      disambiguatingDescription: footer.disclaimer,
    },
    {
      '@type': 'MedicalWebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: hub.title,
      headline: florida.headline,
      description: florida.metaDescription,
      abstract: stripCites(florida.answer),
      inLanguage: 'en-US',
      dateModified: floridaUpdated,
      lastReviewed: florida.updated,
      isPartOf: { '@id': new URL('#website', origin).href },
      publisher: { '@id': new URL('#organization', origin).href },
      about: {
        '@type': 'ImagingTest',
        name: 'Magnetic resonance imaging (MRI)',
        imagingTechnique: 'MRI',
        sameAs: ['https://www.wikidata.org/wiki/Q161238'],
      },
      spatialCoverage: { '@type': 'State', name: 'Florida' },
      citation: sources.map((s) => ({
        '@type': 'CreativeWork',
        name: s.title,
        publisher: { '@type': 'Organization', name: s.publisher },
        url: s.url,
        datePublished: s.date,
      })),
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: mriCityPage.breadcrumb.home, item: origin },
          { '@type': 'ListItem', position: 2, name: mriCityPage.breadcrumb.hub, item: pageUrl },
        ],
      },
      hasPart: {
        '@type': 'ItemList',
        name: hub.cityTableCaption,
        numberOfItems: cities.length,
        itemListElement: cities.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: mriCityPage.title(c.city),
          url: new URL(cityPath(c), origin).href,
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: florida.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: stripCites(f.a) },
      })),
    },
  ],
};
---

<Base title={hub.docTitle} description={florida.metaDescription} mdPath="/fl/mri/index.md" modified={floridaUpdated}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  <Nav />

  <main id="main">
    <div class="page doc">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">{mriCityPage.breadcrumb.home}</a></li>
          <li aria-current="page">{mriCityPage.breadcrumb.hub}</li>
        </ol>
      </nav>

      <article class="doc-body wide">
        <header>
          <span class="kicker">{hub.kicker}</span>
          <h1 class="doc-headline">{florida.headline}</h1>
          <p class="doc-meta tnum">
            <time datetime={floridaUpdated}>{mriCityPage.updatedLabel} {updated}</time>
            <span aria-hidden="true"> · </span>
            <a href="#sources">{sources.length} {mriCityPage.sourcesLabel}</a>
          </p>
          <p class="doc-answer" set:html={cite(florida.answer)} />
        </header>

        <section class="takeaways" aria-labelledby="takeaways">
          <h2 id="takeaways" class="kicker">{mriCityPage.takeawaysLabel}</h2>
          <ul>
            {florida.takeaways.map((t) => <li set:html={cite(t)} />)}
          </ul>
        </section>

        <section class="sec">
          <h2>{hub.cityTableCaption}</h2>
          <div class="table-wrap">
            <table class="wide">
              <thead>
                <tr>
                  {hub.cityColumns.map((c) => <th scope="col">{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  cities.map((c) => (
                    <tr>
                      <th scope="row">
                        <a href={cityPath(c)}>{mriCityPage.title(c.city)}</a>
                        {c.nearby.length > 0 && (
                          <span class="cell-sub">
                            {mriCityPage.alsoCovers} {c.nearby.join(', ')}
                          </span>
                        )}
                      </th>
                      <td>{c.county}</td>
                      <td class="tnum">{stripCites(c.priceRange)}</td>
                      <td class="tnum">{c.providers.length}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section class="sec">
          <h2>{florida.priceHeading}</h2>
          <p set:html={cite(florida.priceSummary)} />
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  {mriCityPage.priceColumns.map((c) => <th scope="col">{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  florida.prices.map((row) => (
                    <tr>
                      <th scope="row">{row.what}</th>
                      <td class="tnum">{row.value}</td>
                      <td class="tnum">
                        <a href={`#src-${n(row.sourceId)}`}>[{n(row.sourceId)}]</a>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        {
          florida.sections.map((s) => (
            <section class="sec">
              <h2>{s.heading}</h2>
              {s.paragraphs.map((para) => (
                <p set:html={cite(para)} />
              ))}
            </section>
          ))
        }

        {
          florida.quotes.length > 0 && (
            <section class="sec">
              <h2>{hub.quotesHeading}</h2>
              {florida.quotes.map((q) => (
                <figure class="quote">
                  <blockquote>
                    <p>“{q.text}”</p>
                  </blockquote>
                  <figcaption>
                    <strong>{q.speaker}</strong>, {q.role}
                    <sup class="cite">
                      <a href={`#src-${n(q.sourceId)}`}>{n(q.sourceId)}</a>
                    </sup>
                  </figcaption>
                </figure>
              ))}
            </section>
          )
        }

        <section class="sec">
          <h2>{mriCityPage.headings.faq('Florida')}</h2>
          <div class="faq-list">
            {
              florida.faqs.map((f) => (
                <div>
                  <h3>{f.q}</h3>
                  <p set:html={cite(f.a)} />
                </div>
              ))
            }
          </div>
        </section>

        <section class="sec" id="sources">
          <h2>{mriCityPage.headings.sources}</h2>
          <ol class="sources">
            {
              sources.map((s, i) => (
                <li id={`src-${i + 1}`}>
                  <a href={s.url} rel="noopener">{s.title}</a>. {s.publisher}, <span class="tnum">{s.date}</span>.
                </li>
              ))
            }
          </ol>
        </section>
      </article>

      <hr class="rule" />
      <SiteFooter />
    </div>
  </main>
</Base>
