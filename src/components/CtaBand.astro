---
import { closing, site } from '../data/site';
---

{/* The one full-bleed crimson field on the page. It closes the argument. */}
<section class="cta-band">
  <div class="page">
    <h2 class="cta-headline">{closing.headline}</h2>
    <div class="cta-actions">
      <a class="btn btn-ghost btn-ghost--invert" href={site.ctaHref}>{site.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .cta-band .page {
    padding-block: 84px;
  }

  .cta-headline {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    margin: 0 0 0 -0.058em;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: 42px;
  }
</style>
